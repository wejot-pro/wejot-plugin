            "description": "题目排序值"
          },
          "type": {
            "type": "string",
            "enum": [
              "UPLOAD"
            ],
            "description": "题目类型，固定为 UPLOAD"
          },
          "condition": {
            "type": "string",
            "description": "显示条件表达式"
          },
          "guide": {
            "type": "string",
            "description": "AI 主持人引导语"
          },
          "followup": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "none",
                  "one",
                  "two_three",
                  "open",
                  "logic"
                ]
              },
              "logicPrompt": {
                "type": "string"
              }
            }
          },
          "accept": {
            "type": "string",
            "description": "允许的文件 MIME 类型，访谈常用写法，如 */*"
          },
          "maxFileCount": {
            "type": "integer",
            "description": "最多上传文件数量"
          },
          "maxFileSize": {
            "type": "integer",
            "description": "单文件最大大小（KB）"
          },
          "fileTypes": {
            "type": "array",
            "description": "允许上传的文件扩展名",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "interviewQuestions": {
